TELEGRAM_BOT_TOKEN=replace-with-bot-token
ADMIN_TELEGRAM_IDS=123456789
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-strong-password@db:5432/threads_bot
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=replace-with-model-slug
OPENROUTER_TIMEOUT_SECONDS=30
DEFAULT_SYSTEM_PROMPT=Создай полезный естественный пост для Threads на русском языке без выдуманных фактов.
THREADS_CLIENT_ID=replace-with-meta-app-id
THREADS_CLIENT_SECRET=replace-with-meta-app-secret
THREADS_REDIRECT_URI=https://your-public-host.example/oauth/threads/callback
THREADS_API_VERSION=v1.0
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
OAUTH_STATE_TTL_SECONDS=600
DEFAULT_POST_INTERVAL_MINUTES=60
LOG_LEVEL=INFO

# Hybrid news generation. Only GUARDIAN_API_KEY is a secret.
GUARDIAN_API_KEY=
NEWS_POST_PERCENT=30
NEWS_LOOKBACK_HOURS=48
NEWS_TOPICS=бизнес,искусственный интеллект,нейросети,аналитика,спорт,технологии,интернет-продукты,стартапы,наука,инновации,финансы,маркетинг,образование,продуктивность,культура
NEWS_BLOCKED_PHRASES=погиб,гибель,убит,убийство,смерть,скончался,война,военный конфликт,теракт,терроризм,катастрофа,авария,крушение,взрыв,стрельба,нападение,жертвы,ранен,насилие,трагедия,неподтвержденный слух,неподтверждённый слух,шок,сенсация

# Amvera only: add these as secrets for the first successful deployment,
# then delete them and restart the application. The token remains encrypted in PostgreSQL.
# THREADS_BOOTSTRAP_TOKEN=long-lived-token-for-the-single-threads-user
# THREADS_BOOTSTRAP_TELEGRAM_ID=123456789
# THREADS_BOOTSTRAP_EXPIRES_AT=2026-09-30T12:00:00+00:00
# Set true only for one restart when intentionally rotating an existing token.
# THREADS_BOOTSTRAP_REPLACE_EXISTING=false
